# Core Django settings
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank for local SQLite. Production PostgreSQL URLs should include
# sslmode=require when required by the hosting provider.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# Google OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local email delivery (prints messages in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SurveySolver <noreply@localhost>
SERVER_EMAIL=SurveySolver <noreply@localhost>

# Production SMTP settings. Change EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend when enabling these values.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
